FROM golang:1.16

ENV GO111MODULE=on \
    CGO_ENABLED=0 \
    GOOS=linux \
    GOARCH=amd64

RUN apt-get update && \
    apt-get install -y wget build-essential pkg-config --no-install-recommends

WORKDIR /build

COPY . .

RUN go get github.com/githubnemo/CompileDaemon
RUN go mod download

# CompileDaemon gets installed here
#ENV PATH="${PATH}:/go/bin/linux_amd64"
